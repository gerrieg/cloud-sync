{
  "name": "cloud-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "auth:hash-password": "tsx src/server/cli/hash-password.ts",
    "auth:totp-generate": "tsx src/server/cli/totp-generate.ts",
    "auth:generate-secrets": "tsx src/server/cli/generate-secrets.ts",
    "docker:verify": "scripts/verify-docker.sh",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^190.0.0",
    "hono": "^4.13.19",
    "ical.js": "^2.2.1",
    "imapflow": "^2.12.2",
    "otpauth": "^9.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdav": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^26.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.2.0"
  }
}

# Copy to .env and fill in. Generate the secrets with the CLI helpers (run `npm install` once first):
#   npm run auth:hash-password     -> USER_PASSWORD_HASH
#   npm run auth:totp-generate     -> TOTP_SECRET (optional; + QR code for your authenticator app)
#   npm run auth:generate-secrets  -> SESSION_SECRET and ENCRYPTION_KEY
# Keep values containing "$" (the bcrypt hash) in single quotes so Docker Compose does not expand them.

# --- Admin login ---
USER_NAME=admin
USER_PASSWORD_HASH=
# Optional second factor. Leave empty to log in with username and password only (the authenticator code is then not asked for).
TOTP_SECRET=

# --- Secrets (required) ---
# At least 32 characters.
SESSION_SECRET=
# 32 bytes as 64 hex characters or base64. Losing or changing it makes stored Apple/Google credentials unreadable.
ENCRYPTION_KEY=

# --- Google OAuth (required) ---
# IMPORTANT: set the OAuth consent screen's publishing status to "In Production". In "Testing" mode
# Google expires refresh tokens after 7 days and the Google connection breaks every week.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---
# Public https URL of this app (e.g. https://sync.example.com). Enables Google Calendar webhooks and the
# Google OAuth redirect; without it Google Calendar is polled instead.
PUBLIC_BASE_URL=
# Host port published by docker-compose.yml (the app listens on 3000 inside the container).
# HOST_PORT=3000
